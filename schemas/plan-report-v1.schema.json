{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebuildwhy.dev/schemas/plan-report-v1.schema.json",
  "title": "RebuildWhy Plan Report V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "pipeline",
    "mode",
    "affected_task_ids",
    "tasks",
    "reasons"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pipeline": {"type": "string", "minLength": 1},
    "mode": {"enum": ["current", "counterfactual"]},
    "affected_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/taskId"}
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["task_id", "decision", "reason_ids"],
        "properties": {
          "task_id": {"$ref": "#/$defs/taskId"},
          "decision": {"enum": ["HIT", "RESTORE", "RUN", "MAY_RUN", "BLOCKED"]},
          "baseline_action_key": {"$ref": "#/$defs/digest"},
          "proposed_action_key": {"$ref": "#/$defs/digest"},
          "proposed_manifest_digest": {"$ref": "#/$defs/digest"},
          "reason_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/reasonId"}
          }
        },
        "additionalProperties": false
      }
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["reason_id", "task_id", "code", "subject", "caused_by"],
        "properties": {
          "reason_id": {"$ref": "#/$defs/reasonId"},
          "task_id": {"$ref": "#/$defs/taskId"},
          "code": {
            "enum": [
              "NEW_TASK",
              "FILE_CONTENT_CHANGED",
              "CONFIG_FIELD_CHANGED",
              "COMMAND_CHANGED",
              "ENVIRONMENT_CHANGED",
              "OUTPUT_CONTRACT_CHANGED",
              "UPSTREAM_ARTIFACT_CHANGED",
              "UPSTREAM_ARTIFACT_MAY_CHANGE",
              "ACTION_RECORD_MISSING",
              "ACTION_RECORD_CORRUPT",
              "OUTPUT_VIEW_MISSING",
              "CACHE_MANIFEST_MISSING",
              "CACHE_MANIFEST_CORRUPT",
              "CACHE_OBJECT_MISSING",
              "CACHE_OBJECT_CORRUPT",
              "REQUIRED_OUTPUT_MISSING",
              "NONDETERMINISTIC_OUTPUT",
              "INVALID_SPEC",
              "MISSING_SOURCE_INPUT",
              "OUTPUT_PATH_CONFLICT"
            ]
          },
          "subject": {"type": "string", "minLength": 1},
          "old_digest": {"$ref": "#/$defs/digest"},
          "new_digest": {"$ref": "#/$defs/digest"},
          "old_value": {},
          "new_value": {},
          "caused_by": {
            "type": "array",
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/reasonId"}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reasonId": {"type": "string", "pattern": "^reason-[0-9]{4,}$"},
    "taskId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"}
  }
}
