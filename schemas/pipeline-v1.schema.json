{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rebuildwhy:schema:pipeline:v1",
  "title": "RebuildWhy Pipeline V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tasks"],
  "properties": {
    "version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]*$"},
      "additionalProperties": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {"not": {"const": "."}},
        {"not": {"pattern": "^/"}},
        {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
        {"not": {"pattern": "\\\\"}},
        {"not": {"pattern": "^\\.rebuildwhy(/|$)"}}
      ]
    },
    "workingDirectory": {
      "anyOf": [
        {"const": "."},
        {"$ref": "#/$defs/relativePath"}
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "output"],
      "properties": {
        "command": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argv"],
          "properties": {
            "argv": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "working_directory": {"$ref": "#/$defs/workingDirectory"}
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "files": {
              "type": "array",
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/relativePath"}
            },
            "config": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "pointers"],
                "properties": {
                  "file": {"$ref": "#/$defs/relativePath"},
                  "pointers": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^(|/)"}
                  }
                }
              }
            },
            "environment": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
            },
            "artifacts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["task", "path"],
                "properties": {
                  "task": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
                  "path": {"$ref": "#/$defs/relativePath"}
                }
              }
            }
          }
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": ["publish", "required"],
          "properties": {
            "publish": {"$ref": "#/$defs/relativePath"},
            "required": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/relativePath"}
            }
          }
        }
      }
    }
  }
}
